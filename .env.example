# Root env for docker-compose (override as needed)

# Backend
APP_NAME=Card Scanner API
ENVIRONMENT=development
ALLOWED_ORIGINS=*
UPLOAD_DIR=/app/storage/uploads
DATABASE_URL=sqlite:////app/storage/app.db
OPENAI_API_KEY=
SHOPER_BASE_URL=
SHOPER_ACCESS_TOKEN=
SHOPER_IMAGE_BASE=
SHOPER_AUTO_SYNC_ON_STARTUP=true
SHOPER_SYNC_TTL_MINUTES=15
SHOPER_PRODUCTS_PATH=/products
SHOPER_ORDERS_PATH=/orders
SHOPER_USERS_PATH=/users
SALES_METRICS_TTL_MINUTES=5
PUBLISH_DRY_RUN=false
DEFAULT_TAX_ID=1
DEFAULT_PRODUCER_ID=23
DEFAULT_LANG_ID=1
DEFAULT_LANGUAGE_CODE=pl_PL
DEFAULT_AVAILABILITY_ID=2
CODE_PREFIX=PKM
IMAGE_NAME_TEMPLATE={name}-{number}.jpg
# Optional mapping
# SET_CATEGORY_MAP={"Paldean Fates":65,"Surging Sparks":58}

# RapidAPI (tcggopro)
RAPIDAPI_KEY=
RAPIDAPI_HOST=pokemon-tcg-api.p.rapidapi.com
TCGGO_BASE_URL=https://pokemon-tcg-api.p.rapidapi.com
TCGGO_SEARCH_PATH=/cards
TCGGO_SEARCH_SEARCH_PATH=/cards/search
TCGGO_SORT=episode_newest

# Pricing
EUR_PLN_RATE=4.3
PRICE_MULTIPLIER=1.24

# ntfy.sh - Rich Mobile Notifications (self-hosted)
# Enable rich order notifications on mobile (requires ntfy app)
NTFY_ENABLED=false
NTFY_URL=http://ntfy
NTFY_TOPIC=kartoteka-orders
NTFY_PRIORITY=urgent
NTFY_AUTH_TOKEN=
# Base URL for clickable links in notifications
APP_BASE_URL=http://localhost:5173
# ntfy server config (for ntfy container)
NTFY_BASE_URL=http://localhost:8080
NTFY_PORT=8080
NTFY_AUTH_DEFAULT_ACCESS=deny-all

# Furgonetka Shipping Integration
# Get credentials from https://sandbox.furgonetka.pl or https://furgonetka.pl
FURGONETKA_CLIENT_ID=
FURGONETKA_CLIENT_SECRET=
FURGONETKA_BASE_URL=https://sandbox.furgonetka.pl
FURGONETKA_SANDBOX_MODE=true
FURGONETKA_REDIRECT_URI=http://localhost:8000/furgonetka/oauth/callback

# Carrier service mapping (Shoper delivery_method_id -> Furgonetka service code)
# Example: {"15": "inpost", "16": "dpd_pickup", "17": "orlen", "18": "dhl"}
FURGONETKA_SERVICE_MAP=

# Default sender address (your warehouse)
FURGONETKA_SENDER_NAME=
FURGONETKA_SENDER_STREET=
FURGONETKA_SENDER_CITY=
FURGONETKA_SENDER_POSTCODE=
FURGONETKA_SENDER_PHONE=
FURGONETKA_SENDER_EMAIL=

# Frontend
VITE_API_BASE_URL=
